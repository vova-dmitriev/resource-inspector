              "id": "browser",
              "title": "Browser",
              "subtitle": "web client",
              "kind": "api",
              "x": 20,
              "y": 80,
              "width": 170,
              "height": 70,
              "endpointIds": [
                "create-order"
              ],
              "resourceRefsByProfile": {
                "local": ["frontend-logs", "web-process"],
                "cloud-staging": ["frontend-logs", "web-process"]
              }
            },
            {
              "id": "api",
              "title": "Ticket API",
              "subtitle": "orders",
              "kind": "service",
              "x": 430,
              "y": 80,
              "width": 180,
              "height": 70,
              "endpointIds": [
                "create-order"
              ],
              "resourceRefsByProfile": {
                "local": ["backend-logs", "api-process"],
                "cloud-staging": ["backend-logs", "api-process"]
              }
            }
          ],
          "edges": [
            {
              "id": "browser-api",
              "from": "browser",
              "to": "api",
              "path": "M 190 115 H 430",
              "label": "POST /orders",
              "labelX": 310,
              "labelY": 104
            }
          ]
        }
      ]
    }
  ],
  "endpoints": [
    {
      "id": "create-order",
      "method": "POST",
      "path": "/api/v1/orders",
      "description": "Creates an order from a checkout draft.",
      "parameters": {
        "headers": {
          "cookie": "guest session"
        }
      },
      "request": {
        "draftId": "draft-01",
        "passengers": [
          {
            "firstName": "Irina",
            "lastName": "Ivanova"
          }
        ]
      },
      "responseType": "OrderDto",
      "responseExample": {
        "id": "order-01",
        "status": "pending_reservation",
        "passengers": [
          {
            "firstName": "Irina",
            "lastName": "Ivanova"
          }
        ]
      },
      "responseSchema": {
        "type": "object",
        "required": [
          "id",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending_reservation",
              "action_required",
              "fulfilled"
            ]
          },
          "passengers": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "firstName"
              ],
              "properties": {
                "firstName": {
                  "type": "string"
                },
                "lastName": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  ],
  "i18n": {
    "defaultLocale": "ru"
  },
